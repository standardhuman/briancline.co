  "quoteApi": {
    "url": "https://briancline.co/api/hull-cleaning-quote",
    "method": "GET",
    "parameters": {
      "service": {
        "values": [
          "cleaning",
          "running_gear",
          "underwater_inspection",
          "item_recovery",
          "propeller_service",
          "anodes_only"
        ],
        "default": "cleaning"
      },
      "length": {
        "description": "Boat length in feet, from the model name (e.g. Islander 36 = 36)",
        "min": 1,
        "max": 200
      },
      "boatType": {
        "values": [
          "sailboat",
          "powerboat"
        ],
        "default": "sailboat"
      },
      "hull": {
        "values": [
          "monohull",
          "catamaran",
          "trimaran"
        ],
        "default": "monohull"
      },
      "frequency": {
        "values": [
          "monthly",
          "bimonthly",
          "quarterly",
          "onetime"
        ],
        "default": "monthly"
      },
      "propellers": {
        "min": 1,
        "max": 4,
        "default": 1
      },
      "anodes": {
        "min": 0,
        "max": 10,
        "default": 0
