      "paintAge": {
        "values": [
          "<6mo",
          "6-12mo",
          "1-1.5yr",
          "1.5-2yr",
          "2+yr"
        ],
        "description": "Age of the antifouling paint. Omit if unknown."
      },
      "lastCleaned": {
        "values": [
          "<2",
          "2-4",
          "5-6",
          "7-8",
          "9-12",
          "13-24",
          "24+"
        ],
        "description": "Time since the last cleaning. Omit if unknown."
      }
    },
    "example": "https://briancline.co/api/hull-cleaning-quote?service=cleaning&length=35&frequency=monthly&paintAge=1-1.5yr&lastCleaned=2-4"
  },
